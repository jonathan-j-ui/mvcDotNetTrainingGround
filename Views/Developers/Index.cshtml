@model List<Developer>;

<h1>Showing @Model.Count developers!</h1>
<table style="width: 100%;">
    <thead>
        <th>Name</th>
        <th>Email</th>
    </thead>
    <tbody>
        @{
            var oddIndex = false;
        }
        @foreach (var developer in Model)
        {
            <tr style="@(oddIndex ? "background-color: #ddd;" : "")">
                <td>@developer.Name</td>
                <td>@developer.Email</td>
            </tr>
            
            oddIndex = !oddIndex;
        }
    </tbody>
</table>