@model List<Developer>;

<h1>Showing @Model.Count developers!</h1>
<table style="width: 100%;">
    <thead>
        <th>Name</th>
        <th>Email</th>
        <th></th>
    </thead>
    <tbody>
        @{
            var oddIndex = false;
        }
        @foreach (var developer in Model)
        {
            <tr style="@(oddIndex ? "background-color: #ddd;" : "")">
                <td>@developer.Name</td>
                <td>@developer.Email</td>
                <td>
                    @Html.ActionLink("Details",
                    "Details",
                    "Developers",
                    new { id = developer.Id })
                </td>
            </tr>
            
            oddIndex = !oddIndex;
        }
    </tbody>
</table>

<a asp-controller="Developers" asp-action="Create">Create new developer</a>